        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep public class com.nhn.android.naverlogin.** { *; } -keep public class com.navercorp.nid.** { *; } -keep class com.naver.nid.** { *; } -keep interface com.naver.nid.** { *; } -keep class com.kakao.sdk.**.model.* { <fields>; } -keep class * extends com.google.gson.TypeAdapter -dontwarn org.bouncycastle.jsse.** -dontwarn org.conscrypt.* -dontwarn org.openjsse.**",
            "extraDependencies": [
              "com.revenuecat.purchases:purchases:9.19.0",
