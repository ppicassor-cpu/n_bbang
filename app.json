      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAXEC--KNqOk_JgpXu9iu1QTlT58TKOpdk"
        }
      },
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
